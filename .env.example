# Copy to .env (or just export these) before running the agent or the eval.
# Required for agent mode and the single-prompt baseline.
# NOT needed for --deterministic mode, the naive baseline, gen-fixtures, or undo.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model (default: claude-sonnet-5)
# DR_MODEL=claude-sonnet-5
